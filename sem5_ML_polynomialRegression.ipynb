from sklearn.preprocessing import PolynomialFeatures

from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
import random

poly = PolynomialFeatures( degree = 2 )

data_indexes = []
data = [ ]
labels = []
for i in range(100) :
  data_row = []
  for j in range(2) :
    data_point = random.randint(0,100)
    data_row.append( data_point )
  random_label = random.randint(0,100)
  #data_row.append( random_label )
  labels.append( random_label )
  data.append( data_row )
  data_indexes.append( i )

X_poly = poly.fit_transform( data )

X_train, X_test, y_train, y_test = train_test_split( X_poly, labels, test_size = 0.2, random_state = 0 )

model = LinearRegression( )
model.fit( X_train, y_train )

y_pred = model.predict( X_test )

m = model.coef_
c = model.intercept_


indexes = []
mse_record = []
model_line = []

for x in range(len(y_pred)) :
  line_point = sum(m*x) + c
  model_line.append( line_point )

for x in range(len(y_pred)) :
  mse = mean_squared_error( y_test, y_pred )
  mse_record.append( mse )
  indexes.append( x )

#print( line )
#mse = sum( mse_record ) / len( mse_record )
